{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",  // where compiled JS files will go
    "esModuleInterop": true,
    "strict": true,  // enable strict mode for better type checking
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"  // include all .ts files in the src folder
  ]
}
